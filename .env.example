# Optional. The Supabase project can instead be entered in Settings -> Cloud
# sync, which keeps it out of the repository entirely. Use this only if you
# would rather bake it into the build.
#
# The anon key is public by design; a static site cannot hide it. What keeps
# the data private is the row-level security policy in supabase/schema.sql.
VITE_SUPABASE_URL=https://yourproject.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
